# =====================================================================
# Copybara: sync nhiều cặp repo (dev -> bàn giao client) + scrub dấu vết AI
# Chỉ cần sửa khối CẤU HÌNH bên dưới.
# Reference: https://github.com/google/copybara/blob/master/docs/reference.md
# =====================================================================

# ----------------------------- CẤU HÌNH ------------------------------
# Mỗi phần tử là 1 cặp repo -> 1 workflow Copybara (tên = "name").
#   name           tên ngắn, dùng khi chạy: sync-local.sh <name>
#   (Quy ước: repo dev chính dùng develop, landing page dùng main; repo client luôn dùng main)
#   source_url     repo dev (nguồn)            source_ref  branch bàn giao (mặc định main)
#   dest_url       repo bàn giao client (đích) dest_base   branch đích (mặc định main)
#   source_dir     thư mục cần sync ở nguồn ("" = toàn repo)
#   dest_dir       vị trí đặt ở đích ("" = root)
#   source_exclude file của nguồn KHÔNG sync (bí mật, tài liệu nội bộ...)
#   dest_keep      file chỉ có ở đích, Copybara không được xoá (khi dest_dir = "")
#
# Copybara thuần có thể xoá file đích không có ở nguồn. sync-local.sh phục hồi
# các file bị xoá và kiểm tra trước push; dest_keep còn bảo vệ khỏi ghi đè.
# Giữ đúng cú pháp {"key": "value"} (script đọc khối này bằng Python).

REPOS = [
    {
        "name": "backend",
        "source_url": "https://github.com/YOUR_ORG/source-backend.git",
        "source_ref": "develop",
        "dest_url": "https://github.com/YOUR_ORG/release-backend.git",
        "dest_base": "main",
        "source_dir": "",
        "dest_dir": "",
        "source_exclude": [
            ".env", ".env.*", "**/appsettings.Development.json", "**/appsettings.Local.json",
            "**/*.user", ".vs/**", ".idea/**", "results/**",
        ],
        "dest_keep": [".github/**"],
    },
]

# ---- Danh tính trên commit ở repo client ----
# AUTHOR_MAP: đổi từng dev sang danh tính khác khi sang client (vd username GitHub).
#   Key   = email dev đang dùng trong git log bên dev (xem lệnh liệt kê trong README)
#   Value = "Tên <email>". Muốn hiện avatar GitHub: "username <ID+username@users.noreply.github.com>"
#           (lấy ID: gh api users/<username> --jq .id)
AUTHOR_MAP = {}

# ALLOWED_AUTHORS: email dev giữ NGUYÊN danh tính (không cần map).
ALLOWED_AUTHORS = []

# Commit của ai không nằm trong 2 danh sách trên (bot AI, email lạ) -> đứng tên DEFAULT_AUTHOR.
# Committer của MỌI commit cũng là DEFAULT_AUTHOR.
DEFAULT_AUTHOR = "Release Maintainer <maintainer@example.com>"

# "ITERATIVE": giữ từng commit. "SQUASH": mỗi lần sync gộp thành 1 commit.
MODE = "ITERATIVE"
# ---------------------------------------------------------------------

AI_TOOLS = "claude|anthropic|chatgpt|openai|gpt-?[0-9]|copilot|cursor|gemini|codex|windsurf|aider|devin|cline|kiro"

# 1) File/thư mục cấu hình của AI tool -> không bao giờ sync.
AI_FILES = [
    "CLAUDE.md", "**/CLAUDE.md", "CLAUDE.local.md", "**/CLAUDE.local.md",
    "AGENTS.md", "**/AGENTS.md", "GEMINI.md", "**/GEMINI.md",
    "SKILL.md", "**/SKILL.md", "SKILLS.md", "**/SKILLS.md",
    "Skills.md", "**/Skills.md", "skills.md", "**/skills.md",
    "skill-sources.json", "**/skill-sources.json", "skills-lock.json", "**/skills-lock.json",
    ".claude/**", "**/.claude/**", ".agents/**", "**/.agents/**",
    ".cursor/**", "**/.cursor/**", ".cursorrules", "**/.cursorrules",
    ".windsurf/**", "**/.windsurf/**", ".windsurfrules", "**/.windsurfrules",
    ".aider*", "**/.aider*",
    ".continue/**", ".codex/**", ".gemini/**", ".kiro/**", ".roo/**", ".roomodes",
    ".clinerules", ".clinerules/**",
    ".github/copilot-instructions.md", ".github/instructions/**", ".github/prompts/**",
    ".mcp.json", "**/.mcp.json", ".playwright-mcp/**", "**/.playwright-mcp/**",
    ".copybara/**",
]

# 2) Commit message: xoá trailer/footer do AI tool thêm.
COMMIT_SCRUBBERS = [
    metadata.scrubber("(?mi)^co-authored-by:[^\\n]*(" + AI_TOOLS + ")[^\\n]*\\n?"),
    metadata.scrubber("(?mi)^[^\\n]*(generated|created|written|made) (with|by|using) [^\\n]*(" + AI_TOOLS + ")[^\\n]*\\n?"),
    metadata.scrubber("(?mi)^claude-session:[^\\n]*\\n?"),
]

# 3) Code: xoá comment đánh dấu AI.
CODE_FILES = glob([
    "**.ts", "**.tsx", "**.js", "**.jsx", "**.mjs", "**.cjs", "**.vue",
    "**.cs", "**.py", "**.go", "**.java", "**.kt", "**.php", "**.rb",
    "**.css", "**.scss", "**.sql", "**.sh", "**.yml", "**.yaml",
])

_AI_PHRASE = "(ai[- ]generated|(generated|written|created) (by|with|using) (ai|an ai|" + AI_TOOLS + "))"

# Cả dòng comment: // Generated by Claude | # AI-generated | -- generated with cursor | " * AI-generated"
AI_COMMENT_LINE = "(?mi)^[ \\t]*(//+|#|--|\\*)[ \\t]*" + _AI_PHRASE + "[^\\n*]*\\n"
# Block comment gọn 1 dòng: /* generated by ChatGPT */
AI_BLOCK_ONE_LINE = "(?mi)^[ \\t]*/\\*+[ \\t]*" + _AI_PHRASE + "[^\\n]*\\*/[ \\t]*\\n"
# Comment cuối dòng code: x = 1; // written by copilot  -> chỉ cắt phần comment
AI_TRAILING = "(?mi)[ \\t]+//[ \\t]*" + _AI_PHRASE + "[^\\n]*$"

CODE_SCRUBBERS = [
    core.replace(before = "${x}", after = "", multiline = True,
                 regex_groups = {"x": AI_COMMENT_LINE}, paths = CODE_FILES),
    core.replace(before = "${x}", after = "", multiline = True,
                 regex_groups = {"x": AI_BLOCK_ONE_LINE}, paths = CODE_FILES),
    core.replace(before = "${x}", after = "", multiline = True,
                 regex_groups = {"x": AI_TRAILING}, paths = CODE_FILES),
]

def _sync_workflow(r):
    source_dir = r.get("source_dir", "")
    dest_dir = r.get("dest_dir", "")
    # Một email có thể xuất hiện ở nhiều nguồn; Copybara yêu cầu allowlist duy nhất.
    allowed_emails = {}
    for email in ALLOWED_AUTHORS + list(AUTHOR_MAP.keys()) + [DEFAULT_AUTHOR.split("<")[1].rstrip(">").strip()]:
        allowed_emails[email] = True

    # dest_keep nằm ở root đích: không nhập các file tương ứng từ nguồn.
    # Khi source_dir được move về root, đổi glob về đường dẫn nguồn trước khi lọc.
    kept_origin_files = []
    if not dest_dir:
        kept_origin_files = [source_dir + "/" + p if source_dir else p for p in r.get("dest_keep", [])]

    origin_files = glob(
        [source_dir + "/**"] if source_dir else ["**"],
        exclude = AI_FILES + r.get("source_exclude", []) + kept_origin_files,
    )
    if dest_dir:
        destination_files = glob([dest_dir + "/**"])
    else:
        destination_files = glob(["**"], exclude = r.get("dest_keep", []))

    transformations = [
        # reversal = []: thao tác một chiều. IGNORE_NOOP: commit sạch thì bỏ qua.
        core.transform(COMMIT_SCRUBBERS + CODE_SCRUBBERS, reversal = [], noop_behavior = "IGNORE_NOOP"),
    ]
    if AUTHOR_MAP:
        transformations.append(metadata.map_author(AUTHOR_MAP, noop_reverse = True))
    if source_dir != dest_dir:
        transformations.append(core.move(source_dir, dest_dir))

    core.workflow(
        name = r["name"],
        origin = git.origin(url = r["source_url"], ref = r.get("source_ref", "main")),
        destination = git.destination(
            url = r["dest_url"],
            fetch = r.get("dest_base", "main"),
            push = "release/sync",   # script ghi đè bằng release/YYYY-MM-DD-HHMMSS
        ),
        origin_files = origin_files,
        destination_files = destination_files,
        authoring = authoring.allowed(
            default = DEFAULT_AUTHOR,
            # luôn có ít nhất 1 phần tử: email của DEFAULT_AUTHOR
            allowlist = list(allowed_emails.keys()),
        ),
        mode = MODE,
        transformations = transformations,
    )

[_sync_workflow(r) for r in REPOS]
