# Copy thành local.env (cùng thư mục) nếu muốn đổi mặc định. Không bắt buộc.

# Bỏ trống để script tự chọn theo Java: 25+ -> v20260907, 21-24 -> v20260727
# COPYBARA_VERSION=v20260907

# WORKFLOW_NAME=core_to_client

# Chạy test trước khi nhận thay đổi của AI (fail -> huỷ phần AI dọn)
# TEST_CMD="npm ci && npm run lint && npm test"
# TEST_CMD="dotnet build && dotnet test"

# AI mặc định tắt. Bật bằng --ai codex hoặc --ai claude.
# AI_ENGINE=codex
# Model mặc định: claude -> claude-sonnet-5-5, codex -> gpt-6.1-sol
# AI_MODEL=claude-sonnet-5-5
# Mức suy luận (mặc định xhigh): low | medium | high | xhigh | max
# AI_EFFORT=xhigh

# true: AI đổi code thật -> tự huỷ thay đổi của AI
# AI_STRICT=true

# Nơi giữ mirror repo đích + bản review
# SYNC_HOME="$HOME/.cache/copybara-sync"
